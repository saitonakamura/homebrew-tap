#!/usr/bin/env bash
# Render Formula/herdr.rb for one saitonakamura/herdr release.
#
#   scripts/render-formula <tag> <SHA256SUMS file>
#
# The bump workflow runs this on every new fork release; run it by hand to
# re-render after editing the template below.
set -euo pipefail

tag=${1:?usage: render-formula <tag> <SHA256SUMS file>}
sums=${2:?usage: render-formula <tag> <SHA256SUMS file>}
version=${tag#v}
# GitHub serves `+` in a release path only percent-encoded
url_tag=${tag//+/%2B}
base="https://github.com/saitonakamura/herdr/releases/download/${url_tag}"

sum() {
  awk -v f="$1" '$2 == f || $2 == "*" f { print $1 }' "$sums"
}

# checked up front: a failure inside the heredoc's $(...) below would not stop the script
missing=0
for f in LICENSE herdr-notices.tar.gz \
  herdr-{macos,linux}-{aarch64,x86_64} herdr-sidebar-{macos,linux}-{aarch64,x86_64}; do
  [ -n "$(sum "$f")" ] || { echo "render-formula: $f is not in $sums" >&2; missing=1; }
done
[ "$missing" = 0 ] || exit 1

block() { # os arch
  local herdr="herdr-$1-$2" sidebar="herdr-sidebar-$1-$2"
  cat <<EOF
      url "${base}/${herdr}"
      sha256 "$(sum "$herdr")"

      resource "herdr-sidebar" do
        url "${base}/${sidebar}"
        sha256 "$(sum "$sidebar")"
      end
EOF
}

cat <<EOF
# Generated by scripts/render-formula from ${tag}; edit the script, not this file.
class Herdr < Formula
  desc "Terminal agent multiplexer (saitonakamura fork of herdrdev/herdr)"
  homepage "https://github.com/saitonakamura/herdr"
  version "${version}"
  license "Apache-2.0"

  on_macos do
    on_arm do
$(block macos aarch64)
    end
    on_intel do
$(block macos x86_64)
    end
  end

  on_linux do
    on_arm do
$(block linux aarch64)
    end
    on_intel do
$(block linux x86_64)
    end
  end

  resource "license" do
    url "${base}/LICENSE"
    sha256 "$(sum LICENSE)"
  end

  resource "notices" do
    url "${base}/herdr-notices.tar.gz"
    sha256 "$(sum herdr-notices.tar.gz)"
  end

  def install
    # the release assets are bare binaries named after their platform
    bin.install Dir["herdr-*"].first => "herdr"
    resource("herdr-sidebar").stage do
      bin.install Dir["herdr-sidebar-*"].first => "herdr-sidebar"
    end
    resource("license").stage { prefix.install "LICENSE" }
    resource("notices").stage { (pkgshare/"notices").install Dir["*"] }
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/herdr --version")
    assert_path_exists bin/"herdr-sidebar"
  end
end
EOF
